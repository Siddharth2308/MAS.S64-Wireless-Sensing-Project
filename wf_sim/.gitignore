# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Run log (regenerated by run_all.py)
results/run_all.log

# YCB meshes from the MITO dataset (third-party data). Re-download into meshes/ with:
#   hf download SignalKinetics/MITO_Dataset <object>/uniform_10000.stl --repo-type dataset
# (objects: 003_cracker_box 005_tomato_soup_can 006_mustard_bottle 021_bleach_cleanser 025_mug)
# Without them run_all.py still runs, on the procedural objects only.
meshes/*.stl

# Tracked on purpose:
#   figs/, results/*.csv, results/summary.json  - report figures and numbers (regenerable, but needed by report.md)
#   hardware/data/, hardware/logs/              - raw IWR1443 recordings: irreplaceable measurements
#   hardware/*.cfg                              - radar configs used for each session
